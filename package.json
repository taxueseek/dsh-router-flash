{
  "name": "dsh-router-flash",
  "version": "0.4.1",
  "description": "DSH agent preset 分发包：探索模式（DeepSeek V4 Flash，模型 id 命中即生效，不绑定渠道）。以 @deepseek-ai/dsh-agent-preset 声明行交付，安装即生效，无落盘同步。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./router-bootstrap": "./lib/router-bootstrap.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/router-flash.patch.yml": "./presets/router-flash.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "presets/",
    "cordis.patch.yml",
    "install.sh",
    "README.md",
    "README.zh.md",
    "intro.png",
    "ui-preset-picker.png",
    "ui-first-turn-tools.png",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "agent-harness",
    "plugin",
    "preset",
    "agent-preset",
    "router",
    "flash",
    "deepseek-v4-flash"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taxueseek/dsh-router-flash.git"
  },
  "homepage": "https://github.com/taxueseek/dsh-router-flash",
  "bugs": {
    "url": "https://github.com/taxueseek/dsh-router-flash/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/router-flash.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dsh": "^0.2.0-rc.2 || ^0.2.1",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible"
      },
      "dshOperations": {
        "0.2.0-rc.2": {
          "install": "unknown",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        }
      }
    }
  },
  "scripts": {
    "test": "node test/router.test.mjs && node scripts/check-composition.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-instructions": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-command-compact": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-persona": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-plan-mode": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-time-context": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-bash": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-goal": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-jobs": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-ralph": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-schedule": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-subagent-control": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-todo": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-web": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-workflow": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-workflow-ptc": "^0.2.0-rc.2"
  }
}
